{
  "name": "orpheus",
  "version": "1.0.0",
  "description": "Bot de música privado para Discord con soporte Spotify (ISRC) y YouTube Music vía Lavalink + Shoukaku",
  "main": "dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "shoukaku": "^4.1.1",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "eslint": "^9.17.0",
    "@typescript-eslint/parser": "^8.19.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "lavalink",
    "shoukaku",
    "spotify",
    "youtube"
  ],
  "license": "UNLICENSED",
  "private": true
}
