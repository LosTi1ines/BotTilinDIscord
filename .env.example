# ═══════════════════════════════════════════════════════════════
# Discord Music Bot — Variables de Entorno
# Copiar este archivo como .env y completar los valores.
# NUNCA subir el archivo .env a Git.
# ═══════════════════════════════════════════════════════════════

# ── Discord ──────────────────────────────────────────────────
# Obtener desde: https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# (Opcional) Guild ID para registrar slash commands en modo desarrollo.
# En producción, dejar vacío para registrar comandos globalmente.
DISCORD_GUILD_ID=

# ── Lavalink ─────────────────────────────────────────────────
# Contraseña compartida entre el Bot y el servidor Lavalink.
# Debe coincidir con LAVALINK_SERVER_PASSWORD en application.yml.
# Usar un valor seguro (ej: openssl rand -hex 32).
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=clave_secreta_lavalink

# ── Spotify ──────────────────────────────────────────────────
# Obtener desde: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# (Opcional) Cookie sp_dc obtenida desde Spotify Web para habilitar playlists algorítmicas (Daily Mix/Discover) y letras.
SPOTIFY_SP_DC=

# ── YouTube OAuth (Opcional - Automatización) ────────────────
# 1. Dejar vacío al inicio, levantar el bot y hacer login manual.
# 2. Copiar el Refresh Token impreso en la consola de Lavalink y pegarlo aquí.
# 3. Cambiar SKIP_INITIALIZATION a true para no repetir el prompt interactivo.
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INITIALIZATION=false

# ── Bot Settings ─────────────────────────────────────────────
BOT_DEFAULT_VOLUME=80
BOT_MAX_QUEUE_SIZE=500
BOT_INACTIVITY_TIMEOUT=300

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
